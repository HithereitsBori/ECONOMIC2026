# Copy to .env.local for local builds (never commit real values). On Netlify set these per site.
# Which site this build is for: attendee | staff
AUDIENCE=
# Google Sheets "Publish to web" CSV URLs (Sheet B: Publish_Schedule / Publish_FAQ_Public)
SCHEDULE_CSV_URL=
PUBLIC_FAQ_CSV_URL=
# STAFF SITE ONLY (Sheet C: Publish_FAQ_Staff). Never set on the attendee site.
STAFF_FAQ_CSV_URL=
# Optional: GA4 measurement id (empty = no analytics loaded)
GA4_ID=
# Attendee: survey link, or SURVEY_DISABLED=1
SURVEY_URL=
SURVEY_DISABLED=
# Attendee: promo creative (assets/promo/*.webp or https URL, 960x300), link and alt, or PROMO_DISABLED=1
PROMO_IMAGE=
PROMO_HREF=
PROMO_ALT=
PROMO_DISABLED=
# Production gate: refuses fixtures / missing data URL / placeholder survey+promo
RELEASE=
# Sample-data preview build (same as --fixtures)
FIXTURES=
# Optional extra leak check: id of the private draft sheet (kept out of the repo)
DRAFT_SHEET_ID=
